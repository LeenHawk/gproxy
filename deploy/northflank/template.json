{
  "apiVersion": "v1.2",
  "arguments": {
    "PROJECT_NAME": "gproxy",
    "HEALTH_CHECK_PATH": "/healthz",
    "PORT": 8787
  },
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "kind": "Project",
          "ref": "project",
          "spec": {
            "name": "${args.PROJECT_NAME}",
            "region": "europe-west"
          }
        },
        {
          "kind": "Workflow",
          "spec": {
            "type": "sequential",
            "context": {
              "projectId": "${refs.project.id}"
            },
            "steps": [
              {
                "kind": "Addon",
                "ref": "database",
                "spec": {
                  "name": "gproxy-db",
                  "type": "postgresql",
                  "version": "16-latest",
                  "billing": {
                    "deploymentPlan": "nf-compute-20",
                    "storage": 4096,
                    "replicas": 1
                  },
                  "tlsEnabled": true,
                  "externalAccessEnabled": false
                }
              },
              {
                "kind": "Condition",
                "spec": {
                  "kind": "Addon",
                  "spec": {
                    "type": "running",
                    "data": {
                      "addonId": "${refs.database.id}",
                      "timeoutDuration": 600
                    }
                  }
                }
              },
              {
                "kind": "SecretGroup",
                "ref": "secrets",
                "spec": {
                  "name": "gproxy-secrets",
                  "type": "secret",
                  "secretType": "environment",
                  "priority": 10,
                  "restrictions": {
                    "restricted": false
                  },
                  "secrets": {
                    "variables": {
                      "GPROXY_ADMIN_PASSWORD": "${fn.randomSecret(32, 'hex')}",
                      "GPROXY_MASTER_KEY": "${fn.randomSecret(32, 'hex')}"
                    }
                  },
                  "addonDependencies": [
                    {
                      "addonId": "${refs.database.id}",
                      "keys": [
                        {
                          "keyName": "POSTGRES_URI",
                          "aliases": [
                            "GPROXY_DATABASE_URL"
                          ]
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "kind": "CombinedService",
                "ref": "gproxy",
                "spec": {
                  "name": "gproxy",
                  "billing": {
                    "deploymentPlan": "nf-compute-20",
                    "buildPlan": "nf-compute-400-16"
                  },
                  "deployment": {
                    "instances": 1
                  },
                  "runtimeEnvironment": {
                    "PORT": "${args.PORT}"
                  },
                  "ports": [
                    {
                      "name": "http",
                      "internalPort": "${args.PORT}",
                      "public": true,
                      "protocol": "HTTP"
                    }
                  ],
                  "healthChecks": [
                    {
                      "protocol": "HTTP",
                      "type": "readinessProbe",
                      "path": "${args.HEALTH_CHECK_PATH}",
                      "port": "${args.PORT}",
                      "initialDelaySeconds": 10,
                      "periodSeconds": 10,
                      "timeoutSeconds": 5,
                      "failureThreshold": 6
                    }
                  ],
                  "vcsData": {
                    "projectType": "github",
                    "projectUrl": "https://github.com/LeenHawk/gproxy",
                    "projectBranch": "dev"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "buildEngine": "buildkit",
                      "dockerFilePath": "/deploy/serverless/Dockerfile",
                      "dockerWorkDir": "/deploy/serverless"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
