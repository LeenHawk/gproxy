# Native musl toolchain for x86_64, ARM64 and RISC-V runners. Alpine's Rust
# package also covers RISC-V musl host tools, which rustup does not distribute.
FROM alpine:edge

RUN apk add --no-cache build-base cargo clang22 clang22-dev cmake git go \
        linux-headers perl pkgconf \
    && ln -s /usr/bin/clang-22 /usr/local/bin/clang

WORKDIR /workspace
