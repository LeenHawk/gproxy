package __PACKAGE__;

import android.app.Activity;
import android.app.AlertDialog;
import android.content.ClipData;
import android.content.ClipboardManager;
import android.content.BroadcastReceiver;
import android.content.Context;
import android.content.DialogInterface;
import android.content.Intent;
import android.content.IntentFilter;
import android.content.SharedPreferences;
import android.net.Uri;
import android.os.Build;
import android.os.Bundle;
import android.os.PowerManager;
import android.provider.Settings;
import android.text.InputType;
import android.util.Base64;
import android.view.View;
import android.widget.Button;
import android.widget.CompoundButton;
import android.widget.EditText;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.Switch;
import android.widget.TextView;
import android.widget.Toast;

import java.security.SecureRandom;

public final class GproxyActivity extends Activity {
    private EditText adminUserInput;
    private EditText adminPasswordInput;
    private Switch autoStartSwitch;
    private Button channelsButton;
    private Switch generateKeySwitch;
    private Button startButton;
    private TextView logView;
    private boolean receiverRegistered;
    private boolean startRequested;
    private final boolean[] selectedChannels = new boolean[20];

    private static final String[] CHANNEL_IDS = {
        "openai", "openrouter", "deepseek", "groq", "nvidia", "vercel", "custom",
        "claudeapi", "aistudio", "vertexexpress", "vertex", "codex", "claudecode",
        "geminicli", "antigravity", "grokbuild", "kiro", "copilotcli", "chatgpt",
        "claudeweb"
    };
    private static final String[] CHANNEL_LABELS = {
        "OpenAI API", "OpenRouter", "DeepSeek", "Groq", "NVIDIA NIM",
        "Vercel AI Gateway", "Custom endpoint (configure base URL later)",
        "Anthropic API", "Google AI Studio", "Vertex AI Express", "Vertex AI",
        "OpenAI Codex", "Claude Code", "Gemini CLI", "Antigravity", "Grok Build",
        "Kiro", "GitHub Copilot CLI", "ChatGPT Web", "Claude Web"
    };

    private final BroadcastReceiver events = new BroadcastReceiver() {
        @Override
        public void onReceive(Context context, Intent intent) {
            String line = intent.getStringExtra(GproxyService.EXTRA_LOG);
            if (line != null && line.length() > 0) {
                log(line);
            }
            if (!GproxyService.isRunning() && !GproxyService.isStarting()) {
                startRequested = false;
            }
            refreshState();
        }
    };

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        final SharedPreferences prefs = getSharedPreferences(GproxyService.PREFS, MODE_PRIVATE);

        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        int pad = dp(16);
        root.setPadding(pad, pad, pad, pad);

        adminUserInput = new EditText(this);
        adminUserInput.setHint("Admin username");
        adminUserInput.setSingleLine(true);
        adminUserInput.setText(prefs.getString(GproxyService.PREF_ADMIN_USER, "admin"));

        adminPasswordInput = new EditText(this);
        adminPasswordInput.setHint("Admin password (plaintext not saved)");
        adminPasswordInput.setSingleLine(true);
        adminPasswordInput.setInputType(
            InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_PASSWORD);

        autoStartSwitch = new Switch(this);
        autoStartSwitch.setText("Start automatically (app launch and device boot)");
        autoStartSwitch.setChecked(prefs.getBoolean(GproxyService.PREF_AUTO_START, true));
        autoStartSwitch.setOnCheckedChangeListener(new CompoundButton.OnCheckedChangeListener() {
            @Override
            public void onCheckedChanged(CompoundButton button, boolean checked) {
                prefs.edit().putBoolean(GproxyService.PREF_AUTO_START, checked).apply();
                log(checked ? "Automatic startup enabled." : "Automatic startup disabled.");
                if (checked) {
                    offerBackgroundPermission(true);
                } else {
                    prefs.edit()
                        .putBoolean(GproxyService.PREF_BACKGROUND_PERMISSION_ASKED, false)
                        .apply();
                }
            }
        });

        channelsButton = new Button(this);
        channelsButton.setText("Choose built-in channels (optional)");
        channelsButton.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View view) {
                chooseChannels();
            }
        });

        generateKeySwitch = new Switch(this);
        generateKeySwitch.setText("Generate an administrator API key (shown once)");
        generateKeySwitch.setChecked(true);

        startButton = new Button(this);
        startButton.setText("Start GPROXY");
        startButton.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View view) {
                startGproxy();
            }
        });

        Button stop = new Button(this);
        stop.setText("Stop");
        stop.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View view) {
                GproxyService.stop(GproxyActivity.this);
            }
        });

        logView = new TextView(this);
        logView.setTextIsSelectable(true);
        log("GPROXY APK installed.");
        String recent = GproxyService.recentLog();
        if (recent.length() > 0) {
            logView.append(recent);
        }

        root.addView(adminUserInput);
        root.addView(adminPasswordInput);
        root.addView(autoStartSwitch);
        root.addView(channelsButton);
        root.addView(generateKeySwitch);
        root.addView(startButton);
        root.addView(stop);
        ScrollView scroll = new ScrollView(this);
        scroll.addView(logView);
        root.addView(scroll, new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT, 0, 1.0f));
        setContentView(root);

        refreshState();
        final boolean adminConfigured = prefs.getBoolean(
            GproxyService.PREF_ADMIN_CONFIGURED,
            prefs.contains(GproxyService.PREF_ADMIN_USER));
        if (adminConfigured) {
            prefs.edit().putBoolean(GproxyService.PREF_ADMIN_CONFIGURED, true).apply();
            refreshState();
        }
        if (autoStartSwitch.isChecked() && adminConfigured) {
            root.post(new Runnable() {
                @Override
                public void run() {
                    startGproxy();
                    offerBackgroundPermission(false);
                }
            });
        } else if (autoStartSwitch.isChecked()) {
            root.post(new Runnable() {
                @Override
                public void run() {
                    offerBackgroundPermission(false);
                }
            });
            log("Choose an admin username and password, then tap Start GPROXY.");
        } else {
            log("Automatic startup is off. Tap Start GPROXY when needed.");
        }
    }

    @Override
    protected void onStart() {
        super.onStart();
        if (!receiverRegistered) {
            registerReceiver(events, new IntentFilter(GproxyService.ACTION_EVENT));
            receiverRegistered = true;
        }
        refreshState();
    }

    @Override
    protected void onResume() {
        super.onResume();
        if (GproxyUpdateProvider.hasPendingUpdate(this)) {
            try {
                GproxyUpdateActivity.launch(this);
            } catch (RuntimeException error) {
                log("Could not open the pending Android update: " + error);
            }
        }
    }

    @Override
    protected void onStop() {
        if (receiverRegistered) {
            unregisterReceiver(events);
            receiverRegistered = false;
        }
        super.onStop();
    }

    private void startGproxy() {
        String adminUser = adminUserInput.getText().toString().trim();
        String adminPassword = adminPasswordInput.getText().toString();
        if (adminUser.length() == 0) {
            adminUser = "admin";
            adminUserInput.setText(adminUser);
        }
        SharedPreferences prefs = getSharedPreferences(GproxyService.PREFS, MODE_PRIVATE);
        boolean adminConfigured = prefs.getBoolean(
            GproxyService.PREF_ADMIN_CONFIGURED,
            prefs.contains(GproxyService.PREF_ADMIN_USER));
        if (!adminConfigured
            && adminPassword.trim().length() == 0) {
            Toast.makeText(this, "Enter an admin password for first-run setup.", Toast.LENGTH_LONG)
                .show();
            return;
        }
        String bootstrapChannels = adminConfigured ? "" : selectedChannelIds();
        String adminApiKey = adminConfigured || !generateKeySwitch.isChecked()
            ? "" : generateApiKey();
        GproxyService.start(
            this, adminUser, adminPassword, bootstrapChannels, adminApiKey);
        startRequested = true;
        refreshState();
        if (adminApiKey.length() > 0) {
            showGeneratedKey(adminApiKey);
        }
    }

    private void refreshState() {
        boolean busy = GproxyService.isRunning()
            || GproxyService.isStarting()
            || startRequested;
        adminUserInput.setEnabled(!busy);
        adminPasswordInput.setEnabled(!busy);
        boolean configured = getSharedPreferences(GproxyService.PREFS, MODE_PRIVATE)
            .getBoolean(GproxyService.PREF_ADMIN_CONFIGURED, false);
        channelsButton.setEnabled(!busy && !configured);
        generateKeySwitch.setEnabled(!busy && !configured);
        startButton.setEnabled(!busy);
    }

    private void chooseChannels() {
        new AlertDialog.Builder(this)
            .setTitle("Built-in channels")
            .setMultiChoiceItems(
                CHANNEL_LABELS,
                selectedChannels,
                new DialogInterface.OnMultiChoiceClickListener() {
                    @Override
                    public void onClick(DialogInterface dialog, int which, boolean checked) {
                        selectedChannels[which] = checked;
                    }
                })
            .setPositiveButton("Done", null)
            .show();
    }

    private String selectedChannelIds() {
        StringBuilder ids = new StringBuilder();
        for (int i = 0; i < CHANNEL_IDS.length; i++) {
            if (!selectedChannels[i]) {
                continue;
            }
            if (ids.length() > 0) {
                ids.append(',');
            }
            ids.append(CHANNEL_IDS[i]);
        }
        return ids.toString();
    }

    private String generateApiKey() {
        byte[] random = new byte[32];
        new SecureRandom().nextBytes(random);
        return "sk-" + Base64.encodeToString(
            random, Base64.URL_SAFE | Base64.NO_PADDING | Base64.NO_WRAP);
    }

    private void showGeneratedKey(final String apiKey) {
        ClipboardManager clipboard = (ClipboardManager) getSystemService(CLIPBOARD_SERVICE);
        if (clipboard != null) {
            clipboard.setPrimaryClip(ClipData.newPlainText("GPROXY admin API key", apiKey));
        }
        EditText key = new EditText(this);
        key.setText(apiKey);
        key.setSingleLine(true);
        key.setSelectAllOnFocus(true);
        key.setKeyListener(null);
        int pad = dp(20);
        LinearLayout content = new LinearLayout(this);
        content.setOrientation(LinearLayout.VERTICAL);
        content.setPadding(pad, 0, pad, 0);
        TextView warning = new TextView(this);
        warning.setText(
            "This key grants administrator access and will not be shown again. "
            + "It has been copied to the clipboard.");
        content.addView(warning);
        content.addView(key);
        new AlertDialog.Builder(this)
            .setTitle("Administrator API key")
            .setView(content)
            .setPositiveButton("Done", null)
            .show();
    }

    private void offerBackgroundPermission(boolean force) {
        if (Build.VERSION.SDK_INT < 23) {
            return;
        }
        PowerManager power = (PowerManager) getSystemService(POWER_SERVICE);
        if (power != null && power.isIgnoringBatteryOptimizations(getPackageName())) {
            return;
        }
        SharedPreferences prefs = getSharedPreferences(GproxyService.PREFS, MODE_PRIVATE);
        if (!force && prefs.getBoolean(GproxyService.PREF_BACKGROUND_PERMISSION_ASKED, false)) {
            return;
        }
        prefs.edit().putBoolean(GproxyService.PREF_BACKGROUND_PERMISSION_ASKED, true).apply();

        new AlertDialog.Builder(this)
            .setTitle("Allow background operation")
            .setMessage(
                "Automatic startup works best when Android does not battery-optimize GPROXY. "
                + "Allow background operation in the next system dialog. You can change this later in Settings.")
            .setNegativeButton("Not now", null)
            .setPositiveButton("Continue", new DialogInterface.OnClickListener() {
                @Override
                public void onClick(DialogInterface dialog, int which) {
                    openBackgroundPermissionSettings();
                }
            })
            .show();
    }

    private void openBackgroundPermissionSettings() {
        Intent request = new Intent(Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS);
        request.setData(Uri.parse("package:" + getPackageName()));
        try {
            startActivity(request);
        } catch (RuntimeException unavailable) {
            try {
                startActivity(new Intent(Settings.ACTION_IGNORE_BATTERY_OPTIMIZATION_SETTINGS));
            } catch (RuntimeException ignored) {
                log("Open Android Settings and allow GPROXY to run in the background.");
            }
        }
    }

    private void log(String line) {
        logView.append(line + "\n");
    }

    private int dp(int value) {
        float density = getResources().getDisplayMetrics().density;
        return (int) (value * density + 0.5f);
    }
}
