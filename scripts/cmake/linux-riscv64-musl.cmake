set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR riscv64)
set(CMAKE_SYSROOT /opt/riscv64-alpine)
set(CMAKE_C_COMPILER riscv64-linux-musl-cc)
set(CMAKE_CXX_COMPILER riscv64-linux-musl-c++)
set(CMAKE_AR /usr/lib/llvm22/bin/llvm-ar)
set(CMAKE_RANLIB /usr/lib/llvm22/bin/llvm-ranlib)
set(CMAKE_FIND_ROOT_PATH /opt/riscv64-alpine)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
