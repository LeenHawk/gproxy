#!/bin/sh
set -eu

data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
data_dir="$data_home/gproxy"
log_dir="$state_home/gproxy"
environment="$data_dir/.env"
console_url="http://127.0.0.1:8787/admin"

mkdir -p "$data_dir" "$log_dir"
if [ ! -f "$environment" ]; then
  umask 077
  secret="$(head -c 32 /dev/urandom | base64)"
  temporary="$environment.tmp.$$"
  {
    printf '%s\n' 'GPROXY_DATA_DIR=.'
    printf 'GPROXY_MASTER_KEY=%s\n' "$secret"
  } > "$temporary"
  mv "$temporary" "$environment"
fi

if ! curl -fsS "$console_url" >/dev/null 2>&1; then
  if [ ! -f "$data_dir/gproxy.db" ] || [ -f "$data_dir/.setup-pending" ]; then
    admin_user="$(zenity --entry --title="Set up GPROXY" \
      --text="Choose your administrator username." --entry-text=admin)" || exit 0
    [ -n "$(printf '%s' "$admin_user" | tr -d '[:space:]')" ] || exit 0
    admin_password="$(zenity --password --title="Set up GPROXY" \
      --text="Choose your administrator password. The password is not saved in plaintext.")" || exit 0
    [ -n "$(printf '%s' "$admin_password" | tr -d '[:space:]')" ] || exit 0
    user_autostart="${XDG_CONFIG_HOME:-$HOME/.config}/autostart/gproxy.desktop"
    if zenity --question --title="Set up GPROXY" \
      --text="Start GPROXY automatically when you sign in?"; then
      rm -f "$user_autostart"
    else
      mkdir -p "$(dirname "$user_autostart")"
      printf '%s\n' '[Desktop Entry]' 'Type=Application' 'Name=GPROXY' 'Hidden=true' > "$user_autostart"
    fi
    touch "$data_dir/.autostart-initialized" "$data_dir/.setup-pending"
    (cd "$data_dir" && GPROXY_ADMIN_USER="$admin_user" GPROXY_ADMIN_PASSWORD="$admin_password" \
      nohup /usr/bin/gproxy >>"$log_dir/gproxy.log" 2>&1 &)
    unset admin_password
  else
    (cd "$data_dir" && nohup /usr/bin/gproxy >>"$log_dir/gproxy.log" 2>&1 &)
  fi
  healthy=false
  attempt=0
  while [ "$attempt" -lt 75 ]; do
    if curl -fsS "$console_url" >/dev/null 2>&1; then
      healthy=true
      break
    fi
    attempt=$((attempt + 1))
    sleep 0.2
  done
  if [ "$healthy" != "true" ]; then
    zenity --error --title="GPROXY" \
      --text="GPROXY did not start. Check $log_dir/gproxy.log." 2>/dev/null || true
    exit 1
  fi
fi

rm -f "$data_dir/.setup-pending"

if [ "${1:-}" = "--open-console" ]; then
  xdg-open "$console_url" >/dev/null 2>&1 || true
fi
