#!/bin/sh
set -eu

contents="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
binary="$contents/MacOS/gproxy-server"
data_dir="$HOME/Library/Application Support/GPROXY"
log_dir="$HOME/Library/Logs/GPROXY"
environment="$data_dir/.env"
launch_agent="$HOME/Library/LaunchAgents/io.github.leenhawk.gproxy.plist"
console_url="http://127.0.0.1:8787/admin"
background=false

if [ "${1:-}" = "--background" ]; then
  background=true
fi

mkdir -p "$data_dir" "$log_dir"
if [ ! -f "$environment" ]; then
  umask 077
  secret="$(openssl rand -base64 32)"
  temporary="$environment.tmp.$$"
  {
    printf '%s\n' 'GPROXY_DATA_DIR=.'
    printf 'GPROXY_MASTER_KEY=%s\n' "$secret"
  } > "$temporary"
  mv "$temporary" "$environment"
fi

is_healthy() {
  curl -fsS "$console_url" >/dev/null 2>&1
}

admin_password=""
admin_user=""
enable_autostart=false
if ! is_healthy && { [ ! -f "$data_dir/gproxy.db" ] || [ -f "$data_dir/.setup-pending" ]; }; then
  [ "$background" = "false" ] || exit 0
  admin_user="$(osascript -e 'text returned of (display dialog "Choose your administrator username." default answer "admin" with title "Set up GPROXY")')" || exit 0
  [ -n "$(printf '%s' "$admin_user" | tr -d '[:space:]')" ] || exit 0
  admin_password="$(osascript -e 'text returned of (display dialog "Choose your administrator password. The password is not saved in plaintext." default answer "" with hidden answer with title "Set up GPROXY")')" || exit 0
  [ -n "$(printf '%s' "$admin_password" | tr -d '[:space:]')" ] || exit 0
  choice="$(osascript -e 'button returned of (display dialog "Start GPROXY automatically when you sign in?" with title "Set up GPROXY" buttons {"No", "Yes"} default button "Yes")')" || exit 0
  [ "$choice" != "Yes" ] || enable_autostart=true
fi

if [ "$enable_autostart" = "true" ] && [ ! -f "$launch_agent" ]; then
  mkdir -p "$(dirname "$launch_agent")"
  escaped="$(printf '%s' "$contents/MacOS/GPROXY" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')"
  temporary="$launch_agent.tmp.$$"
  {
    printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>'
    printf '%s\n' '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
    printf '%s\n' '<plist version="1.0"><dict>'
    printf '%s\n' '<key>Label</key><string>io.github.leenhawk.gproxy</string>'
    printf '<key>ProgramArguments</key><array><string>%s</string><string>--background</string></array>\n' "$escaped"
    printf '%s\n' '<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>'
    printf '%s\n' '</dict></plist>'
  } > "$temporary"
  chmod 600 "$temporary"
  mv "$temporary" "$launch_agent"
fi

if [ -n "$admin_password" ]; then touch "$data_dir/.autostart-initialized" "$data_dir/.setup-pending"; fi

if ! is_healthy; then
  (
    cd "$data_dir"
    if [ -n "$admin_password" ]; then
      export GPROXY_ADMIN_USER="$admin_user" GPROXY_ADMIN_PASSWORD="$admin_password"
    fi
    exec "$binary" >>"$log_dir/gproxy.log" 2>&1
  ) &
  server_pid=$!
  unset admin_password
  healthy=false
  attempt=0
  while [ "$attempt" -lt 75 ]; do
    if is_healthy; then healthy=true; break; fi
    if ! kill -0 "$server_pid" 2>/dev/null; then break; fi
    attempt=$((attempt + 1))
    sleep 0.2
  done
  if [ "$healthy" != "true" ]; then
    osascript -e 'display alert "GPROXY" message "GPROXY did not start. Check the log in Library/Logs/GPROXY."' >/dev/null
    exit 1
  fi
fi

rm -f "$data_dir/.setup-pending"

if [ "$background" = "false" ]; then
  open "$console_url"
else
  while is_healthy; do sleep 5; done
fi
