{
  "name": "@gproxy/console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/sync-to-embed.mjs",
    "lint": "tsc -b --pretty false && eslint . && pnpm i18n:check",
    "test": "vitest run",
    "types": "GPROXY_TS_OUT=\"$PWD/src/generated/sdk\" cargo test --manifest-path ../Cargo.toml -p gproxy-sdk --features ts --lib dto::export -- --exact dto::export::export_types && GPROXY_TS_OUT=\"$PWD/src/generated/app\" cargo test --manifest-path ../Cargo.toml -p gproxy-app --features ts --lib dto::export -- --exact dto::export::export_types",
    "i18n:check": "node scripts/i18n-parity.mjs && node scripts/i18n-unused.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tauri-apps/api": "^2.12.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^27.0.0",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.0",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-mono": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource-variable/noto-sans-tc": "5.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^31.0.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "^11.0.4"
    }
  }
}
