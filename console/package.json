{
  "name": "@gproxy/console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "fonts:update": "node scripts/update-fonts.mjs",
    "build": "tsc -b && vite build && node scripts/sync-to-embed.mjs",
    "lint": "tsc -b --pretty false && eslint . && pnpm i18n:check",
    "test": "vitest run",
    "types": "GPROXY_TS_OUT=\"$PWD/src/generated/sdk\" cargo test --manifest-path ../Cargo.toml -p gproxy-sdk --features ts --lib dto::export -- --exact dto::export::export_types && GPROXY_TS_OUT=\"$PWD/src/generated/app\" cargo test --manifest-path ../Cargo.toml -p gproxy-app --features ts --lib dto::export -- --exact dto::export::export_types",
    "i18n:check": "node scripts/i18n-parity.mjs && node scripts/i18n-unused.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@tauri-apps/api": "^2.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-mono": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/noto-sans-tc": "5.3.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.2"
  }
}
