FROM node:24.21.0-trixie AS node
FROM golang:1.27.1-trixie AS go
FROM rust:1.98.0-trixie AS base
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=go /usr/local/go /usr/local/go
ENV PATH="/opt/cross/bin:/usr/local/go/bin:${PATH}"
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && npm install -g pnpm@9.15.9 \
    && apt-get update \
    && apt-get install -y --no-install-recommends clang lld llvm libclang-dev \
       cmake ninja-build nasm pkg-config jq zip unzip python3 python3-venv \
       openssl wine \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/cross \
    && /opt/cross/bin/pip install --no-cache-dir cargo-xwin==0.23.1 cargo-zigbuild==0.23.4 \
    && rustup target add x86_64-pc-windows-msvc aarch64-pc-windows-msvc x86_64-apple-darwin aarch64-apple-darwin

# A pinned SDK and an ad-hoc signer let CLI and Application remain separate
# macOS builds on Linux. Apple tooling later signs the app and creates its DMG.
RUN curl -fsSL --retry 5 --retry-all-errors \
      https://github.com/joseluisq/macosx-sdks/releases/download/26.1/MacOSX26.1.sdk.tar.xz -o /tmp/sdk.tar.xz \
    && echo 'beee7212d265a6d2867d0236cc069314b38d5fb3486a6515734e76fa210c784c  /tmp/sdk.tar.xz' | sha256sum -c - \
    && tar -xJf /tmp/sdk.tar.xz -C /opt && rm /tmp/sdk.tar.xz \
    && curl -fsSL --retry 5 --retry-all-errors \
      https://github.com/indygreg/apple-platform-rs/releases/download/apple-codesign/0.29.0/apple-codesign-0.29.0-x86_64-unknown-linux-musl.tar.gz -o /tmp/codesign.tar.gz \
    && echo 'dbe85cedd8ee4217b64e9a0e4c2aef92ab8bcaaa41f20bde99781ff02e600002  /tmp/codesign.tar.gz' | sha256sum -c - \
    && mkdir /tmp/codesign && tar -xzf /tmp/codesign.tar.gz -C /tmp/codesign \
    && find /tmp/codesign -type f -name rcodesign -exec install -m755 {} /usr/local/bin/rcodesign \; \
    && rm -rf /tmp/codesign /tmp/codesign.tar.gz

FROM base AS upx
RUN git init /tmp/upx \
    && git -C /tmp/upx remote add origin https://github.com/upx/upx.git \
    && git -C /tmp/upx fetch --depth 1 origin b888ad87f5d7d8d890777b03d71f09d01a8eb902 \
    && git -C /tmp/upx checkout --detach FETCH_HEAD \
    && git -C /tmp/upx submodule update --init --recursive --depth 1 \
    && cmake -S /tmp/upx -B /tmp/upx/build -DCMAKE_BUILD_TYPE=Release -DUPX_CONFIG_DISABLE_WERROR=ON \
    && cmake --build /tmp/upx/build --parallel 8

FROM base
COPY --from=upx /tmp/upx/build/upx /opt/upx-arm64/bin/upx
