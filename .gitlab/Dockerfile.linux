FROM docker.io/library/node:24.21.0-trixie@sha256:1278a37eb510ec1606fba0e80f554bcc941ae0b44f35ae373c4822ae7717c64d AS node
FROM docker.io/library/golang:1.27.1-trixie@sha256:8f58fd67ea075142d947a60e0caa4317746a55118d312f027793d382c7741734 AS go
FROM docker.io/library/rust:1.99.0-trixie@sha256:81015672d6939b0265f09adf96d5de125482bb1330106076956b0518e74edc90
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=go /usr/local/go /usr/local/go
ENV PATH="/opt/cross/bin:/usr/local/go/bin:${PATH}"
ARG TARGET_ARCH=amd64
# Zig 0.16 emits libc++ nullability warnings while linking RISC-V musl.
# Keep the tested 0.15 toolchain until the bundled libc++ is fixed.
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && npm install -g pnpm@9.15.9 \
    && printf 'path-exclude=/usr/share/man/*\n' > /etc/dpkg/dpkg.cfg.d/99-no-manpages \
    && rm -rf /usr/share/man \
    && dpkg --add-architecture "$TARGET_ARCH" \
    && apt-get update \
    && apt-get install -y --no-install-recommends clang lld llvm libclang-dev \
       cmake ninja-build nasm pkg-config jq zip unzip python3 python3-venv \
       openssl patchelf qemu-user gcc-aarch64-linux-gnu g++-aarch64-linux-gnu \
       gcc-riscv64-linux-gnu g++-riscv64-linux-gnu \
       libwebkit2gtk-4.1-dev:$TARGET_ARCH libgtk-3-dev:$TARGET_ARCH \
       libsoup-3.0-dev:$TARGET_ARCH libdbus-1-dev:$TARGET_ARCH \
       libayatana-appindicator3-dev:$TARGET_ARCH librsvg2-dev:$TARGET_ARCH \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/cross \
    && /opt/cross/bin/pip install --no-cache-dir cargo-zigbuild==0.23.4 ziglang==0.15.2 \
    && rustup component add clippy rustfmt \
    && rustup target add riscv64gc-unknown-linux-gnu riscv64gc-unknown-linux-musl aarch64-unknown-linux-gnu x86_64-unknown-linux-musl aarch64-unknown-linux-musl wasm32-unknown-unknown
