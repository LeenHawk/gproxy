FROM docker.io/library/debian:trixie-20261005-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
COPY --from=docker:28-cli /usr/local/bin/docker /usr/local/bin/docker
# Rust, Go, Node, Gradle and pnpm come from scripts/mobile/android-toolchain.sh,
# the same pins the F-Droid prebuild installs. Do not add versioned base images
# here: the F-Droid build must reproduce this image's APK.
ENV RUSTUP_HOME=/opt/gproxy-toolchain/rustup CARGO_HOME=/opt/gproxy-toolchain/cargo \
    ANDROID_HOME=/opt/android ANDROID_SDK_ROOT=/opt/android \
    ANDROID_NDK_HOME=/opt/android/ndk/30.0.15729638 NDK_HOME=/opt/android/ndk/30.0.15729638 \
    JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
# The first line matches the F-Droid recipe's `sudo` packages.
RUN apt-get update \
    && apt-get install -y --no-install-recommends clang cmake g++ libclang-dev make pkg-config ninja-build \
       python3 rustup unzip xz-utils \
       ca-certificates curl git jq zip openssl python3-pip openjdk-21-jdk-headless \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/mobile/android-toolchain.sh /tmp/android-toolchain.sh
RUN bash -c 'set -euo pipefail; source /tmp/android-toolchain.sh; install_android_toolchain /opt/gproxy-toolchain'
# android_toolchain_path, then Cargo and the SDK tools.
ENV PATH="/opt/gproxy-toolchain/node/bin:/opt/gproxy-toolchain/pnpm/bin:/opt/gproxy-toolchain/go/bin:/opt/gproxy-toolchain/gradle/bin:/opt/gproxy-toolchain/cargo/bin:/opt/android/cmdline-tools/latest/bin:/opt/android/platform-tools:${PATH}"
RUN curl -fsSL --retry 5 --retry-all-errors \
      https://dl.google.com/android/repository/commandlinetools-linux-16111833_latest.zip -o /tmp/android.zip \
    && echo 'e025545c62a8e64c7559119566a569fb1dec5f60  /tmp/android.zip' | sha1sum -c - \
    && mkdir -p /opt/android/cmdline-tools \
    && unzip -q /tmp/android.zip -d /opt/android/cmdline-tools \
    && mv /opt/android/cmdline-tools/cmdline-tools /opt/android/cmdline-tools/latest \
    && rm /tmp/android.zip \
    && yes | sdkmanager --licenses >/dev/null
RUN sdkmanager 'platform-tools' 'platforms;android-36' 'build-tools;36.1.0' 'build-tools;34.0.0' 'ndk;30.0.15729638' \
    && cargo install cargo-ndk --locked --version 4.1.2 \
    && python3 -m pip install --break-system-packages apksigcopier==1.1.1
COPY scripts/install-android-upx.sh /tmp/install-android-upx.sh
COPY scripts/install-android-upx.patch /tmp/install-android-upx.patch
RUN bash /tmp/install-android-upx.sh /opt/gproxy-android-upx
ENV PATH="/opt/gproxy-android-upx/bin:${PATH}"
