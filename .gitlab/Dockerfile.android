FROM node:24.21.0-trixie AS node
FROM golang:1.27.1-trixie AS go
FROM rust:1.98.0-trixie
COPY --from=docker:28-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=go /usr/local/go /usr/local/go
ENV PATH="/opt/android/cmdline-tools/latest/bin:/opt/android/platform-tools:/usr/local/go/bin:${PATH}" \
    ANDROID_HOME=/opt/android ANDROID_SDK_ROOT=/opt/android \
    ANDROID_NDK_HOME=/opt/android/ndk/30.0.15729638 NDK_HOME=/opt/android/ndk/30.0.15729638 \
    JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && npm install -g pnpm@9.15.9 \
    && apt-get update \
    && apt-get install -y --no-install-recommends clang cmake libclang-dev \
       pkg-config jq zip unzip python3 python3-pip openssl openjdk-21-jdk-headless \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL --retry 5 --retry-all-errors \
      https://dl.google.com/android/repository/commandlinetools-linux-16111833_latest.zip -o /tmp/android.zip \
    && echo 'e025545c62a8e64c7559119566a569fb1dec5f60  /tmp/android.zip' | sha1sum -c - \
    && mkdir -p /opt/android/cmdline-tools \
    && unzip -q /tmp/android.zip -d /opt/android/cmdline-tools \
    && mv /opt/android/cmdline-tools/cmdline-tools /opt/android/cmdline-tools/latest \
    && rm /tmp/android.zip \
    && yes | sdkmanager --licenses >/dev/null
RUN sdkmanager 'platform-tools' 'platforms;android-36' 'build-tools;36.1.0' 'build-tools;34.0.0' 'ndk;30.0.15729638' \
    && rustup target add x86_64-linux-android aarch64-linux-android \
    && cargo install cargo-ndk --locked --version 4.1.2

# The same pinned Gradle distribution used by F-Droid after source scanning.
RUN curl -fsSL --retry 3 https://services.gradle.org/distributions/gradle-8.14.3-bin.zip -o /tmp/gradle.zip \
    && echo 'bd71102213493060956ec229d946beee57158dbd89d0e62b91bca0fa2c5f3531  /tmp/gradle.zip' | sha256sum -c - \
    && unzip -q /tmp/gradle.zip -d /opt && rm /tmp/gradle.zip \
    && python3 -m pip install --break-system-packages apksigcopier==1.1.1
COPY scripts/install-android-upx.sh /tmp/install-android-upx.sh
RUN bash /tmp/install-android-upx.sh /opt/gproxy-android-upx
ENV PATH="/opt/gradle-8.14.3/bin:/opt/gproxy-android-upx/bin:${PATH}"
