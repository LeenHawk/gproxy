# GPROXY's Go build dependency on top of the shared, verified OHOS toolchain.
FROM golang:1.27.1-trixie AS go
FROM ghcr.io/leenhawk/tauri-harmony@sha256:7aec029f4881062e160db0e01ac0068f6fe78f6255b752ff23c04c3913f86f7a
COPY --from=go /usr/local/go /usr/local/go
COPY scripts/ohos/compiler-warnings.patch /opt/gproxy-compiler-warnings.patch
RUN cd /opt/ohos-tauri && git apply --check /opt/gproxy-compiler-warnings.patch \
    && git apply /opt/gproxy-compiler-warnings.patch
COPY scripts/install-android-upx.sh /opt/gproxy-install-upx.sh
RUN bash /opt/gproxy-install-upx.sh /opt/gproxy-upx
ENV PATH="/opt/gproxy-upx/bin:/usr/local/go/bin:${PATH}"
