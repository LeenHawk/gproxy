---
import { Tabs, TabItem } from '@astrojs/starlight/components';

interface Props {
  locale: 'en' | 'zh-CN' | 'zh-TW' | 'ru';
  topic?: 'sillytavern' | 'routes' | 'users' | 'logs' | 'claude' | 'codex' | 'cherry';
  title?: string;
}
const { locale, topic = 'sillytavern', title = 'GPROXY × SillyTavern' } = Astro.props;
const languages: Array<'en' | 'zh'> = locale === 'en' || locale === 'ru' ? ['en', 'zh'] : ['zh', 'en'];
const base = `/tutorials/${topic}`;
const labels = {
  en: { tab: locale === 'ru' ? 'Английское видео' : 'English', captions: 'English', lang: 'en' },
  zh: { tab: locale === 'ru' ? 'Китайское видео' : '中文', captions: '简体中文', lang: 'zh-CN' },
};
---

<div class="tutorial-player">
  {locale === 'ru' && <p>Русские субтитры доступны для английского видео.</p>}
  <Tabs>
    {languages.map((language) => {
      const copy = labels[language];
      return <TabItem label={copy.tab}>
        <video
          controls
          controlslist="nodownload"
          playsinline
          preload="metadata"
          width="1600"
          height="900"
          poster={`${base}/${language}.webp`}
          aria-label={`${title} · ${copy.tab}`}
        >
          <source src={`${base}/${language}.mp4`} type="video/mp4" />
          {locale === 'ru' && language === 'en' && <track kind="subtitles" src={`${base}/ru.vtt`} srclang="ru" label="Русский" default />}
          <track kind="captions" src={`${base}/${language}.vtt`} srclang={copy.lang} label={copy.captions} default={locale !== 'ru' || language !== 'en'} />
        </video>
      </TabItem>;
    })}
  </Tabs>
</div>

<style>
  .tutorial-player {
    margin-block: 1.5rem 2rem;
  }
  video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: #101820;
  }
</style>

<script>
  document.querySelectorAll('.tutorial-player').forEach((player) => {
    player.querySelectorAll('video').forEach((video) => {
      video.addEventListener('play', () => {
        document.querySelectorAll<HTMLVideoElement>('.tutorial-player video').forEach((other) => {
          if (other !== video) other.pause();
        });
      });
    });
    const pause = () => player.querySelectorAll('video').forEach((video) => video.pause());
    player.querySelector('[role="tablist"]')?.addEventListener('click', pause);
    player.querySelector('[role="tablist"]')?.addEventListener('keydown', (event) => {
      if (event instanceof KeyboardEvent && ['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) pause();
    });
  });
</script>
