/**
 * The download page body, shared by the three locales.
 *
 * Package lists are static — they mirror `scripts/release-targets.json` and
 * the attachment names the Release workflow publishes — and every link starts
 * out pointing at the GitHub release page. A small script then asks the
 * GitHub API for the latest release and rewrites each link to the matching
 * attachment, fills in the version, date and sizes, and picks a recommended
 * package for the visitor's platform. Without JavaScript, or when the API is
 * rate-limited, the page still works: the release page lists every file.
 */
interface Props {
  locale: 'en' | 'zh-CN' | 'zh-TW';
}
const { locale } = Astro.props;

const REPO = 'https://github.com/LeenHawk/gproxy';
const LATEST = `${REPO}/releases/latest`;
const NIGHTLY = `${REPO}/releases/tag/nightly`;
const prefix = locale === 'en' ? '' : `/${locale.toLowerCase()}`;

