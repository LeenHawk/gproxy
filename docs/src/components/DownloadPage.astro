type Pkg = { asset: string; label: string; tag?: string };
type Row = { arch: 'x86_64' | 'aarch64' | 'riscv64'; variant?: string; app: Pkg[]; cli: Pkg[] };
type Platform = { id: 'linux' | 'windows' | 'macos' | 'android' | 'ohos'; rows: Row[]; store?: boolean };

const linuxRows = (['x86_64', 'aarch64', 'riscv64'] as const).flatMap((arch): Row[] => [
  { arch, variant: 'GNU', app: [{ asset: `gproxy-tauri-linux-${arch}.zip`, label: 'ZIP' }, { asset: `gproxy-tauri-linux-${arch}.deb`, label: 'DEB' }], cli: [{ asset: `gproxy-linux-${arch}.zip`, label: 'ZIP' }, { asset: `gproxy-linux-${arch}.deb`, label: 'DEB' }] },
  { arch, variant: 'musl', app: [], cli: [{ asset: `gproxy-linux-${arch}-musl.zip`, label: 'ZIP' }, { asset: `gproxy-linux-${arch}-musl.deb`, label: 'DEB' }] },
]);
const platforms: Platform[] = [
  { id: 'linux', rows: linuxRows },
  { id: 'windows', store: true, rows: (['x86_64', 'aarch64'] as const).map((arch) => ({ arch, app: [{ asset: `gproxy-tauri-windows-${arch}.zip`, label: 'ZIP' }, { asset: `gproxy-tauri-windows-${arch}.msix`, label: 'MSIX' }], cli: [{ asset: `gproxy-windows-${arch}.zip`, label: 'ZIP' }, { asset: `gproxy-windows-${arch}.msix`, label: 'MSIX' }] })) },
  { id: 'macos', rows: (['aarch64', 'x86_64'] as const).map((arch) => ({ arch, app: [{ asset: `gproxy-tauri-macos-${arch}.dmg`, label: 'DMG' }, { asset: `gproxy-tauri-macos-${arch}.zip`, label: 'ZIP' }], cli: [{ asset: `gproxy-macos-${arch}.zip`, label: 'ZIP' }, { asset: `gproxy-macos-${arch}.dmg`, label: 'DMG' }] })) },
  { id: 'android', rows: (['aarch64', 'x86_64'] as const).map((arch) => ({ arch, app: [{ asset: `gproxy-tauri-android-${arch}.apk`, label: 'APK' }], cli: [{ asset: `gproxy-android-${arch}.deb`, label: 'Termux DEB' }, { asset: `gproxy-android-${arch}.zip`, label: 'ZIP' }] })) },
  { id: 'ohos', rows: (['aarch64', 'x86_64'] as const).map((arch) => ({ arch, app: [{ asset: `gproxy-tauri-ohos-${arch}-unsigned.hap`, label: 'HAP', tag: `${copy.experimental} · ${copy.unsigned}` }], cli: [{ asset: `gproxy-ohos-${arch}.zip`, label: 'ZIP' }] })) },
];
const headless = [
  ...(['x86_64', 'aarch64', 'riscv64'] as const).flatMap((arch) => [`gproxy-headless-linux-${arch}.zip`, `gproxy-headless-linux-${arch}-musl.zip`]),
  'gproxy-headless-windows-x86_64.zip', 'gproxy-headless-windows-aarch64.zip',
  'gproxy-headless-macos-aarch64.zip', 'gproxy-headless-macos-x86_64.zip',
  'gproxy-headless-android-aarch64.zip', 'gproxy-headless-android-x86_64.zip',
];
const headlessLabel = (asset: string) => asset.replace(/^gproxy-headless-/, '').replace(/\.zip$/, '');
---

<div class="dl not-content" data-locale={locale} data-latest={LATEST}>
  <header class="dl-hero">
    <p class="dl-eyebrow">{copy.eyebrow}</p>
    <h1 class="dl-title">{copy.title}</h1>
    <p class="dl-lede">{copy.lede}</p>
    <div class="dl-release" aria-live="polite">
      <span class="dl-pill"><span class="dl-dot" aria-hidden="true"></span><span class="dl-label">{copy.latest}</span> <strong data-release-version>…</strong></span>
      <span class="dl-date" data-release-date>{copy.loading}</span>
      <a class="dl-link" data-release-notes href={LATEST}>{copy.notes} ↗</a>
      <a class="dl-link" href={`${REPO}/releases`}>{copy.allReleases}</a>
      <a class="dl-link" href={NIGHTLY}>{copy.nightly}</a>
    </div>
    <p class="dl-offline" data-offline hidden>{copy.offline}</p>
  </header>

  <section class="dl-foryou" data-foryou hidden>
    <div class="dl-foryou-head">
      <h2>{copy.forYou}</h2>
      <p>{copy.forYouHint} <span data-foryou-platform class="dl-mono"></span></p>
    </div>
    <div class="dl-foryou-cards">
      <a class="dl-primary" data-foryou-app href={LATEST} hidden>
        <span class="dl-primary-kind">{copy.app}</span>
        <span class="dl-primary-name" data-foryou-app-name></span>
        <span class="dl-primary-hint">{copy.appHint}</span>
      </a>
      <a class="dl-primary dl-primary--cli" data-foryou-cli href={LATEST} hidden>
        <span class="dl-primary-kind">{copy.cli}</span>
        <span class="dl-primary-name" data-foryou-cli-name></span>
        <span class="dl-primary-hint">{copy.cliHint}</span>
      </a>
    </div>
  </section>

  <section class="dl-platforms">
    <h2>{copy.platforms}</h2>
    <div class="dl-grid">
      {platforms.map((platform) => (
        <article class="dl-card" data-platform={platform.id}>
          <header class="dl-card-head">
            <h3>{copy.os[platform.id].name}</h3>
            <p>{copy.os[platform.id].hint}</p>
          </header>
          <table class="dl-table">
            <thead><tr><th scope="col"></th><th scope="col">{copy.app}</th><th scope="col">{copy.cli}</th></tr></thead>
            <tbody>
              {platform.rows.map((row) => (
                <tr>
                  <th scope="row"><span>{copy.arch[row.arch]}</span>{row.variant ? <span class="dl-variant">{row.variant}</span> : null}</th>
                  <td>{row.app.length ? row.app.map((pkg) => (
                    <a class="dl-asset" href={LATEST} data-asset={pkg.asset} title={pkg.asset}>{pkg.label}{pkg.tag ? <small>{pkg.tag}</small> : null}<span class="dl-size" data-size></span></a>
                  )) : <span class="dl-none">—</span>}</td>
                  <td>{row.cli.map((pkg) => (
                    <a class="dl-asset" href={LATEST} data-asset={pkg.asset} title={pkg.asset}>{pkg.label}<span class="dl-size" data-size></span></a>
                  ))}</td>
                </tr>
              ))}
            </tbody>
          </table>
          {platform.store ? (
            <footer class="dl-store">
              <span>{copy.store}</span>
              <a href="https://apps.microsoft.com/detail/9P2FJRB9RS4Z?mode=direct">{copy.storeDesktop} ↗</a>
              <a href="https://apps.microsoft.com/detail/9NBMH3S5K0L9?mode=direct">{copy.storeCli} ↗</a>
            </footer>
          ) : null}
        </article>
      ))}

      <article class="dl-card dl-card--wide">
        <header class="dl-card-head">
          <h3>{copy.headless}</h3>
          <p>{copy.headlessHint}</p>
        </header>
        <div class="dl-chips">
          {headless.map((asset) => <a class="dl-asset" href={LATEST} data-asset={asset} title={asset}>{headlessLabel(asset)}<span class="dl-size" data-size></span></a>)}
        </div>
      </article>
    </div>
  </section>

  <section class="dl-more">
    <article class="dl-card">
      <h3>{copy.container}</h3>
      <p>{copy.containerBody}</p>
      <pre class="dl-code"><code>docker pull leenhawk/gproxy:<span data-release-tag>latest</span></code></pre>
      <a class="dl-link" href={`${prefix}/deployment/containers/`}>{copy.containerGuide} →</a>
    </article>
    <article class="dl-card">
      <h3>{copy.hosted}</h3>
      <p>{copy.hostedBody}</p>
      <a class="dl-link" href={`${prefix}/deployment/edge/`}>{copy.hostedGuide} →</a>
    </article>
    <article class="dl-card">
      <h3>{copy.source}</h3>
      <p>{copy.sourceBody}</p>
      <pre class="dl-code"><code>cargo build --release -p gproxy</code></pre>
      <a class="dl-link" href={`${prefix}/deployment/release-build/`}>{copy.sourceGuide} →</a>
    </article>
    <article class="dl-card">
      <h3>{copy.verify}</h3>
      <p>{copy.verifyBody}</p>
      <div class="dl-chips">
        <a class="dl-asset" href={LATEST} data-asset="SHA256SUMS">{copy.sums}</a>
        <a class="dl-asset" href={LATEST} data-asset="manifest.json">{copy.manifest}</a>
      </div>
    </article>
  </section>

  <p class="dl-next">{copy.next} <a href={`${prefix}/getting-started/installation/`}>{copy.nextLink}</a>.</p>
</div>

<script>
  type Asset = { name: string; browser_download_url: string; size: number };
  type Release = { tag_name: string; html_url: string; published_at: string; assets: Asset[] };

  const root = document.querySelector<HTMLElement>('.dl');
  if (root) {
    const locale = root.dataset.locale ?? 'en';
    const ua = navigator.userAgent;
    const detect = () => {
      const data = (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData;
      const platform = (data?.platform ?? navigator.platform ?? '').toLowerCase();
      const arm = /aarch64|arm64|armv8/i.test(ua);
      if (/openharmony|harmonyos/i.test(ua)) return { os: 'ohos', arch: arm ? 'aarch64' : 'x86_64' };
      if (/android/i.test(ua)) return { os: 'android', arch: /x86_64|x64/i.test(ua) ? 'x86_64' : 'aarch64' };
      if (/iphone|ipad/i.test(ua)) return null;
      if (platform.startsWith('win') || /windows/i.test(ua)) return { os: 'windows', arch: arm ? 'aarch64' : 'x86_64' };
      // Safari on Apple Silicon reports an Intel platform string; prefer ARM64
      // and let the table offer the other.
      if (platform.startsWith('mac') || /macintosh/i.test(ua)) return { os: 'macos', arch: 'aarch64' };
      if (platform.includes('linux') || /linux/i.test(ua)) return { os: 'linux', arch: arm ? 'aarch64' : /riscv/i.test(ua) ? 'riscv64' : 'x86_64' };
      return null;
    };

    const human = (bytes: number) => bytes >= 1 << 30 ? `${(bytes / (1 << 30)).toFixed(1)} GB` : bytes >= 1 << 20 ? `${(bytes / (1 << 20)).toFixed(1)} MB` : `${Math.round(bytes / 1024)} KB`;

    const apply = (release: Release) => {
      const byName = new Map(release.assets.map((asset) => [asset.name, asset]));
      root.querySelectorAll<HTMLAnchorElement>('a[data-asset]').forEach((link) => {
        const asset = byName.get(link.dataset.asset ?? '');
        if (!asset) { link.classList.add('dl-asset--missing'); return; }
        link.href = asset.browser_download_url;
        const size = link.querySelector<HTMLElement>('[data-size]');
        if (size) size.textContent = human(asset.size);
      });
      root.querySelectorAll<HTMLElement>('[data-release-version]').forEach((el) => { el.textContent = release.tag_name; });
      root.querySelectorAll<HTMLElement>('[data-release-tag]').forEach((el) => { el.textContent = release.tag_name; });
      const notes = root.querySelector<HTMLAnchorElement>('[data-release-notes]');
      if (notes) notes.href = release.html_url;
      const date = root.querySelector<HTMLElement>('[data-release-date]');
      if (date) {
        const when = new Date(release.published_at);
        const released = { en: 'released ', 'zh-CN': '发布于 ', 'zh-TW': '發布於 ' }[locale] ?? '';
        date.textContent = Number.isNaN(when.getTime()) ? '' : `${released}${new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(when)}`;
      }

      const guess = detect();
      const section = root.querySelector<HTMLElement>('[data-foryou]');
      if (!guess || !section) return;
      // First match in document order: the rows put the preferred package
      // first (GNU before musl, DMG before ZIP, APK, ZIP before MSIX).
      const links = [...root.querySelectorAll<HTMLAnchorElement>(`[data-platform="${guess.os}"] a[data-asset]`)].filter((a) => byName.has(a.dataset.asset ?? ''));
      const app = links.find((a) => a.dataset.asset?.startsWith(`gproxy-tauri-${guess.os}-${guess.arch}`));
      const cli = links.find((a) => a.dataset.asset?.startsWith(`gproxy-${guess.os}-${guess.arch}`));
      const fill = (slot: string, link: HTMLAnchorElement | undefined) => {
        const target = root.querySelector<HTMLAnchorElement>(`[data-foryou-${slot}]`);
        const name = root.querySelector<HTMLElement>(`[data-foryou-${slot}-name]`);
        if (!target || !name || !link) return false;
        target.href = link.href;
        name.textContent = link.dataset.asset ?? '';
        target.hidden = false;
        return true;
      };
      const shown = [fill('app', app), fill('cli', cli)].some(Boolean);
      const label = root.querySelector<HTMLElement>('[data-foryou-platform]');
      if (label) label.textContent = `${guess.os} · ${guess.arch}`;
      section.hidden = !shown;
    };

    fetch('https://api.github.com/repos/LeenHawk/gproxy/releases/latest', { headers: { Accept: 'application/vnd.github+json' } })
      .then((response) => (response.ok ? response.json() : Promise.reject(new Error(String(response.status)))))
      .then((release: Release) => apply(release))
      .catch(() => {
        root.querySelector<HTMLElement>('[data-offline]')?.removeAttribute('hidden');
        root.querySelectorAll<HTMLElement>('[data-release-version]').forEach((el) => { el.textContent = 'latest'; });
        const label = root.querySelector<HTMLElement>('[data-release-date]');
        if (label) label.textContent = '';
      });
  }
</script>

