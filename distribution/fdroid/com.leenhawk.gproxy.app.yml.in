AntiFeatures:
  NonFreeNet:
    en-US: Offers integrations with proprietary AI services. Users provide their own
      accounts and can configure other compatible endpoints.
Categories:
  - Development
  - Internet
License: AGPL-3.0-or-later
AuthorName: Leen Hawk
WebSite: https://gproxy.leenhawk.com
SourceCode: https://github.com/LeenHawk/gproxy
IssueTracker: https://github.com/LeenHawk/gproxy/issues
Changelog: https://github.com/LeenHawk/gproxy/releases

AutoName: GPROXY

RepoType: git
Repo: https://github.com/LeenHawk/gproxy.git

Builds:
  - versionName: @VERSION@
    versionCode: @CODE@
    commit: @COMMIT@
    sudo:
      - apt-get update
      - apt-get install -y clang cmake g++ libclang-dev make pkg-config ninja-build
        python3 rustup unzip xz-utils
    output: dist/mobile/fdroid/aarch64/gproxy-fdroid-aarch64.apk
    prebuild: bash scripts/mobile/fdroid-tools.sh
    build:
      - export ANDROID_HOME=$$SDK$$ ANDROID_NDK_HOME=$$NDK$$
      - bash scripts/mobile/fdroid-build.sh
    ndk: 30.0.15729638

AutoUpdateMode: Version
UpdateCheckMode: Tags ^v[0-9]+\.[0-9]+\.[0-9]+$
UpdateCheckData: 
  distribution/mobile/tauri.store.conf.json|"versionCode":\s*(\d+)|crates/gproxy-host-tauri/tauri.conf.json|"version":\s*"([^"]+)"
CurrentVersion: @VERSION@
CurrentVersionCode: @CODE@
